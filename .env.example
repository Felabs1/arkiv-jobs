# Browser (Next.js) settings: copy to .env.local
# The public Tiramisu RPC has a tiny anonymous query budget. Get an access key at
# https://hub.arkiv.network/api-keys (network: Tiramisu) and put it in the URL path.
# This value ships to the browser, so lock the key to your origin in the Hub.
NEXT_PUBLIC_ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network/<your-key>

# Agent settings live in .env.agents (created by `npm run keys`):
#   PRIVATE_KEY_SCRIBE / PRIVATE_KEY_ANALYST / PRIVATE_KEY_CODER
#   OPENROUTER_API_KEY, optional OPENROUTER_MODEL (default google/gemini-2.5-flash-lite)
#   ARKIV_RPC_URL (same keyed URL as above)
